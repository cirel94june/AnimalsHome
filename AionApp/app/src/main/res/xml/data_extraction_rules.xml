<?xml version="1.0" encoding="utf-8"?>
<!-- 同 backup_rules.xml：归巢数据不进云备份，也不在换机传输时带走。Android 12 及以上用这份。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="homecoming/" />
        <exclude domain="file" path="homecoming-returns/" />
        <exclude domain="database" path="homecoming.db" />
        <exclude domain="database" path="homecoming.db-journal" />
        <exclude domain="database" path="homecoming.db-wal" />
        <exclude domain="database" path="homecoming.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="homecoming/" />
        <exclude domain="file" path="homecoming-returns/" />
        <exclude domain="database" path="homecoming.db" />
        <exclude domain="database" path="homecoming.db-journal" />
        <exclude domain="database" path="homecoming.db-wal" />
        <exclude domain="database" path="homecoming.db-shm" />
    </device-transfer>
</data-extraction-rules>
