<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1a1a2e">

    <!-- Logo / 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textColor="#ff8359"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="连接你的 AionsHome 服务器"
        android:textSize="15sp"
        android:textColor="#aaaaaa"
        android:layout_marginBottom="32dp" />

    <!-- 服务器地址（部署完成时会给出，例如 https://名字.xxx.ts.net） -->
    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:hint="https://你的服务器地址"
        android:inputType="textUri"
        android:singleLine="true"
        android:imeOptions="actionGo"
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:backgroundTint="#ff8359"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="🌐  连接"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:backgroundTint="#2d4a6e"
        android:padding="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvServerHint"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="手机需要先打开 Tailscale 并登录"
        android:textSize="12sp"
        android:textColor="#777777"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnHomecoming"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="🏠  归巢模式"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:backgroundTint="#704838"
        android:padding="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvHomecomingHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="服务器不可用时使用"
        android:textSize="12sp"
        android:textColor="#777777"
        android:layout_marginBottom="24dp" />

    <!-- 记住选择 -->
    <CheckBox
        android:id="@+id/cbRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="记住地址，下次自动连接"
        android:textSize="13sp"
        android:textColor="#888888"
        android:buttonTint="#ff8359" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="手势返回到首页可修改地址"
        android:textSize="11sp"
        android:textColor="#555555"
        android:layout_marginTop="16dp" />

</LinearLayout>
